{
  "name": "quizbowl-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:rules": "node scripts/firebase.mjs emulators:exec --project demo-quizbowl --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:practice": "node --test tests/practice.test.mjs tests/practice-persistence.test.mjs",
    "test:statistics": "node --test tests/statistics.test.mjs",
    "test:history": "node --test tests/history.test.mjs",
    "test:anki": "node --test tests/anki-export.test.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests scripts next.config.ts playwright.config.ts package.json",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src tests scripts next.config.ts playwright.config.ts package.json",
    "emulators": "node scripts/firebase.mjs emulators:start --project demo-quizbowl --only auth,firestore"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
