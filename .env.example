# Copy to .env.local. Firebase web configuration is public, not an admin credential.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local demo only: use demo-quizbowl and a dummy API key with the emulators.
# Never enable this on Vercel.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Private server configuration for code-protected administrator registration.
# Generate a random code of at least 16 characters; never use NEXT_PUBLIC_.
ADMIN_SIGNUP_CODE=

# Legacy fallback: ADMIN_SIGNUP_TEAM_ID (prefer SITE_TEAM_ID below)
FIREBASE_ADMIN_PROJECT_ID=
# Local development can use an existing Application Default Credentials file.
GOOGLE_APPLICATION_CREDENTIALS=
# Hosting: provide a Firebase service account with Auth + Firestore permissions.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Gemini Developer API: use a free-tier AI Studio project without billing.
# Never prefix private keys with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Explicit opt-in; keep false until a supported model and quota are configured.
GEMINI_GENERATION_ENABLED=false

# Each school deployment has a separate team ID; all sign-ins join this team.
SITE_TEAM_ID=quizbowl-team
NEXT_PUBLIC_TEAM_NAME=Your high school
