rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function staffFor(teamId) {
      return verified() && exists(staffPath())
        && get(staffPath()).data.role in ['teacher', 'admin']
        && get(staffPath()).data.teamId == teamId;
    }
    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'bio', 'grade', 'preferences', 'createdAt', 'updatedAt'])
        && data.displayName is string && data.displayName.matches('.*[^\\s].*')
        && data.displayName.size() <= 80
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('grade' in data) || data.grade in ['', '6', '7', '8', '9', '10', '11', '12', 'college', 'other'])
        && (!('preferences' in data) || (
          data.preferences.keys().hasAll(['theme', 'reducedMotion'])
          && data.preferences.keys().hasOnly(['theme', 'reducedMotion'])
          && data.preferences.theme in ['light', 'dark', 'system']
          && data.preferences.reducedMotion is bool))
        && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      // Canonical practice sessions and all writes are managed by the server.
      // Students can read only their own recorded responses.
      match /attempts/{attemptId} { allow read: if owner(uid); }
    }
    // Staff assignments are provisioned only through a trusted project administrator.
    match /staff/{uid} { allow get: if owner(uid); }
    // Legacy records remain readable by their owners; joining is server-managed.
    match /memberships/{uid} { allow get: if owner(uid); }
    match /teams/{teamId} {
      allow get: if staffFor(teamId) || (signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)));
      match /members/{uid} {
        allow get: if owner(uid) || staffFor(teamId);
        allow list: if staffFor(teamId);
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName;
      }
    }
    // Server-only: sessions/questions, receipts, dailyStatistics (and markers),
    // aiClueCache, aiUsage, aiGenerationUsage, apiRateLimits, retention controls,
    // decks, assignment progress, calendar events, and announcements.
    // Admin SDK callers must enforce current authorization in their transactions.
    match /{document=**} { allow read, write: if false; }
  }
}
