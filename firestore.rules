rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() { return request.auth != null && request.auth.uid == userId; }
      function validProfile() {
        return request.resource.data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if isOwner();
      allow create: if isOwner() && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if isOwner() && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
